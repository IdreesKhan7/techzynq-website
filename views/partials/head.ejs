<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="<%= description || 'TechZynq — AI & Technology News' %>" />

  <%
    // Social images must be ABSOLUTE URLs and a format every crawler supports.
    // We serve pre-rendered 1200x630 JPEGs from /images/social — WebP is not
    // reliably rendered by Facebook, LinkedIn or WhatsApp.
    const origin = typeof siteOrigin !== 'undefined' ? siteOrigin : '';
    let socialImg = origin + '/images/social/default.jpg';
    if (typeof article !== 'undefined' && article && article.coverImage) {
      const base = article.coverImage.split('/').pop().replace(/\.[a-z]+$/i, '');
      socialImg = origin + '/images/social/' + base + '.jpg';
    }
  %>

  <!-- Open Graph -->
  <meta property="og:site_name"   content="TechZynq" />
  <meta property="og:title"       content="<%= title %>" />
  <meta property="og:description" content="<%= description || '' %>" />
  <meta property="og:type"        content="<%= typeof article !== 'undefined' ? 'article' : 'website' %>" />
  <meta property="og:url"         content="<%= typeof reqUrl !== 'undefined' ? reqUrl : '' %>" />
  <meta property="og:image"       content="<%= socialImg %>" />
  <meta property="og:image:secure_url" content="<%= socialImg %>" />
  <meta property="og:image:type"  content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="<%= title %>" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="<%= title %>" />
  <meta name="twitter:description" content="<%= description || '' %>" />
  <meta name="twitter:image"       content="<%= socialImg %>" />
  <meta name="twitter:image:alt"   content="<%= title %>" />

  <!-- JSON-LD for articles -->
  <% if (typeof article !== 'undefined' && article) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": "<%= article.title.replace(/"/g, '\\"') %>",
    "description": "<%= (article.excerpt || '').replace(/"/g, '\\"') %>",
    "datePublished": "<%= article.publishedAt %>",
    "dateModified": "<%= article.updatedAt %>",
    "author": { "@type": "Person", "name": "<%= article.author.name %>" },
    "publisher": { "@type": "Organization", "name": "TechZynq" }
  }
  </script>
  <% } %>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicon — the TechZynq logo mark, served at sensible sizes.
       Do not add an SVG icon here: browsers prefer SVG, and the placeholder
       favicon.svg in this folder is not the real brand logo. -->
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
</head>
<body class="min-h-screen bg-brand-bg text-brand-text font-body">
